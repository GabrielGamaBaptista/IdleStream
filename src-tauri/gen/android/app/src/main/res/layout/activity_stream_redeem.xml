<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#09090b">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#18181b">

        <Button
            android:id="@+id/btn_close_redeem"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✕ Fechar"
            android:textColor="#a1a1aa"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txt_redeem_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Stream"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_redeem_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conta • Plataforma"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reload_redeem"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🔄 Recarregar"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/redeem_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Webview -->
    <WebView
        android:id="@+id/redeem_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
